---
import "@fontsource-variable/inter";
import interLatin from "@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url";
import "@/styles/global.css";
import { site } from "@/lib/content";
import Nav from "@/components/Nav.astro";

const title = `${site.name} — ${site.role}`;
const description = site.tagline;
const keywords = [
  site.name,
  "Infrastructure Engineer",
  "ML Engineer",
  "MLOps",
  "Data Engineering",
  "DevOps",
  "Python",
  "Docker",
  "Kubernetes",
  "Portfolio",
];
const url = new URL("/", Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="keywords" content={keywords.join(",")} />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Runs before paint: apply the saved theme (dark by default) and flag JS. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = "dark";
        try {
          theme = localStorage.getItem("theme") || "dark";
        } catch {}
        root.classList.toggle("dark", theme === "dark");
        root.classList.add("js");
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <div class="scroll-progress" aria-hidden="true"></div>
    <Nav />
    <slot />

    <script>
      // Reveal [data-reveal] blocks once, when they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -12% 0px" },
      );
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));

      const calmMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;

      // "Decode" effect: headings scramble into place when they scroll into view.
      if (!calmMotion) {
        const glyphs = "!<>-_/[]{}=+*^?#01";
        const decode = (el: HTMLElement) => {
          const text = el.textContent ?? "";
          el.setAttribute("aria-label", text);
          const start = performance.now();
          const total = 650;
          const tick = (now: number) => {
            const t = Math.min((now - start) / total, 1);
            const shown = Math.floor(t * text.length);
            el.textContent = [...text]
              .map((c, i) =>
                c === " " || i < shown ? c : glyphs[Math.floor(Math.random() * glyphs.length)],
              )
              .join("");
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = text;
          };
          requestAnimationFrame(tick);
        };
        const scrambler = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              decode(entry.target as HTMLElement);
              scrambler.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -12% 0px" },
        );
        document.querySelectorAll<HTMLElement>("[data-scramble]").forEach((el) => scrambler.observe(el));
      }

      // Pointer effects: magnetic button + 3D tilt on project cards.
      const fine = matchMedia("(hover: hover) and (pointer: fine)").matches;
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (fine && !calm) {
        // Magnetic buttons: lean toward the cursor when it's near.
        document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((btn) => {
          addEventListener(
            "pointermove",
            (e) => {
              const r = btn.getBoundingClientRect();
              const dx = e.clientX - (r.left + r.width / 2);
              const dy = e.clientY - (r.top + r.height / 2);
              const near = Math.hypot(dx, dy) < Math.max(r.width, r.height) * 0.9;
              btn.style.transform = near
                ? `translate(${(dx * 0.22).toFixed(1)}px, ${(dy * 0.3).toFixed(1)}px)`
                : "";
            },
            { passive: true },
          );
        });

        document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((card) => {
          const box = card.querySelector<HTMLElement>(".tilt-frame")!;
          card.addEventListener("pointermove", (e) => {
            const r = box.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width;
            const y = (e.clientY - r.top) / r.height;
            card.style.setProperty("--ry", `${((x - 0.5) * 9).toFixed(2)}deg`);
            card.style.setProperty("--rx", `${((0.5 - y) * 7).toFixed(2)}deg`);
            card.style.setProperty("--gx", `${(x * 100).toFixed(1)}%`);
            card.style.setProperty("--gy", `${(y * 100).toFixed(1)}%`);
          });
          card.addEventListener("pointerleave", () => {
            card.style.setProperty("--rx", "0deg");
            card.style.setProperty("--ry", "0deg");
          });
        });
      }
    </script>
  </body>
</html>
