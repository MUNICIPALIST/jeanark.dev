---
import Base from "@/layouts/Base.astro";
import Marquee from "@/components/Marquee.astro";
import Hero from "@/components/sections/Hero.astro";
import About from "@/components/sections/About.astro";
import Stack from "@/components/sections/Stack.astro";
import Work from "@/components/sections/Work.astro";
import { site } from "@/lib/content";
import { container } from "@/lib/utils";

const year = new Date().getFullYear();
---

<Base>
  <main>
    <Hero />
    <Marquee />
    <About />
    <Stack />
    <Work />
  </main>
  <footer class="border-t border-border py-8">
    <div
      class={`${container} flex flex-col items-start justify-between gap-2 text-xs text-muted sm:flex-row sm:items-center`}
    >
      <span>© {year} {site.name}</span>
      <span>Built with Astro &amp; Tailwind</span>
    </div>
  </footer>
</Base>
