---
import { stack } from "@/lib/content";

const items = [...new Set(stack.flatMap((g) => g.items))];
---

<div class="marquee border-t border-border py-5" aria-hidden="true">
  <div class="marquee-track">
    {
      [0, 1].map(() => (
        <ul class="flex shrink-0 items-center">
          {items.map((item) => (
            <li class="flex items-center whitespace-nowrap font-display text-lg font-medium text-muted">
              <span class="px-6">{item}</span>
              <span class="text-accent">✦</span>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</div>
