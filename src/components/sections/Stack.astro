---
import { stack } from "@/lib/content";
import { container } from "@/lib/utils";
import Reveal from "@/components/Reveal.astro";
---

<section id="stack" class="border-t border-border py-24 md:py-32">
  <div class={container}>
    <Reveal>
      <p class="text-xs uppercase tracking-[0.2em] text-muted">Stack</p>
    </Reveal>
    <Reveal delay={0.05}>
      <h2 data-scramble class="mt-4 max-w-2xl font-display text-3xl font-medium leading-tight md:text-4xl">
        Tools I build with
      </h2>
    </Reveal>

    <div class="mt-12 border-t border-border">
      {
        stack.map((group, i) => (
          <Reveal delay={i * 0.05}>
            <div class="grid grid-cols-1 gap-3 border-b border-border py-7 md:grid-cols-12 md:gap-8">
              <h3 class="font-display text-lg font-medium md:col-span-3">{group.group}</h3>
              <ul class="flex flex-wrap gap-2 md:col-span-9">
                {group.items.map((item, j) => (
                  <li
                    class="chip rounded-full border border-border px-3 py-1 text-sm text-muted"
                    style={`--i: ${j}`}
                  >
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </Reveal>
        ))
      }
    </div>
  </div>
</section>
