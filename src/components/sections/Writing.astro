---
import { articles } from "@/lib/content";
import { container } from "@/lib/utils";
import Reveal from "@/components/Reveal.astro";
---

<section id="writing" class="border-t border-border py-24 md:py-32">
  <div class={container}>
    <Reveal y={12}>
      <p class="text-xs uppercase tracking-[0.2em] text-muted">Writing</p>
      <h2 data-scramble class="mt-4 max-w-2xl font-display text-3xl font-medium leading-tight md:text-4xl">
        Notes &amp; articles
      </h2>
    </Reveal>

    <ul class="mt-12 divide-y divide-border border-y border-border">
      {
        articles.map((a, i) => (
          <li data-reveal style={`--reveal-y: 14px; --delay: ${i * 0.06}s`}>
            <a href={a.href} class="group flex flex-col gap-3 py-8 sm:flex-row sm:items-start sm:justify-between sm:gap-8">
              <div class="max-w-2xl">
                <h3 class="font-display text-xl font-medium tracking-tight transition-colors group-hover:text-accent">
                  {a.title}
                  <span aria-hidden="true" class="ml-1 inline-block transition-transform group-hover:translate-x-1">→</span>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">{a.blurb}</p>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {a.tags.map((t) => (
                    <li class="rounded-full border border-border px-2.5 py-0.5 text-[11px] text-muted">{t}</li>
                  ))}
                </ul>
              </div>
              <span class="shrink-0 text-xs text-muted">{a.date}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
